#!/usr/sbin/nft -f
# Configuration fictive et anonyme — fixture de test Calque.
# Adressage RFC1918 inventé ; aucun équipement ni nom réel.

flush ruleset

# Réseau d'administration : seul autorisé vers SSH/HTTPS de l'hôte.
define net_admin = 10.20.30.0/24

table inet filtre {
    # Postes de supervision : ensemble nommé, résolu tardivement.
    set postes_surv {
        type ipv4_addr
        flags interval
        elements = { 10.20.40.0/26, 10.20.41.16/28,
                     10.20.42.7 }
    }

    chain entree {
        type filter hook input priority 0; policy drop;

        # Analyse sans état : ces deux règles ne concernent pas le
        # trafic initiateur (voir l'adaptateur, note Info).
        ct state established,related accept
        ct state invalid drop

        iifname "lo" accept
        ip saddr $net_admin tcp dport { 22, 443 } accept
        ip saddr @postes_surv udp dport 161 accept
        ip protocol icmp accept
        counter comment "refus comptés par la politique par défaut"
    }

    chain transit {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        # Préfixe interdit en transit, quelle que soit la destination.
        ip saddr 192.168.99.0/24 drop
        iifname "lan0" oifname "wan0" jump sortie_lan
    }

    # Chaîne régulière : cible du saut, sans accroche propre. Si rien ne
    # correspond, l'évaluation reprend après la règle de saut.
    chain sortie_lan {
        tcp dport { 80, 443 } accept
        tcp dport 8080-8090 accept
        udp dport 53 accept
        meta l4proto icmp accept
    }

    chain sortie {
        type filter hook output priority filter; policy accept;

        oifname "wan0" udp dport 123 accept comment "ntp sortant"
        log prefix "sortie: "
    }
}
